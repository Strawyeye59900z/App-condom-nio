# Nome do condomínio exibido na interface do app
VITE_APP_NAME="Nome do Condomínio"

# URL pública do app (via Cloudflare Tunnel, ex: https://condo.seudominio.com)
APP_URL="https://condo.seudominio.com"
VITE_APP_URL="https://condo.seudominio.com"

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
VITE_POCKETBASE_URL=http://localhost:8090

# Credenciais do PocketBase (superadmin)
POCKETBASE_ADMIN_EMAIL=admin@pb.local
POCKETBASE_ADMIN_PASSWORD=changeme

# E-mail e senha do admin principal do app (síndico)
VITE_ADMIN_EMAIL=admin@condominio.com
ADMIN_PASSWORD=changeme

# Gemini API (opcional — usado para features de IA)
GEMINI_API_KEY=
